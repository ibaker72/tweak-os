# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — bypasses RLS. Never expose to the client.
#
# Also what POST /api/agents invites a new teammate with: creating a login in
# auth.users needs the Auth Admin API, which the anon key cannot reach. Without
# this the Invite Agent button in Settings answers 503 and says so; every other
# part of the app keeps working.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Supabase Auth — where an invitation link comes back to
# ------------------------------------------------------------
# The invitation email links to Supabase, which redirects to
# `${APP_BASE_URL}/setup-password` (see the APP_BASE_URL block
# further down — the same origin the Twilio callbacks use).
# That page reads the session out of the URL fragment and asks
# the new teammate to choose a password.
#
# THIS URL MUST BE ON THE PROJECT'S REDIRECT ALLOW-LIST. If it
# is not, Supabase silently ignores it and sends the invitee to
# the Site URL instead, where nothing can accept the invitation:
#
#   Dashboard -> Authentication -> URL Configuration
#     Site URL:       https://app.tweakandbuild.com
#     Redirect URLs:  https://app.tweakandbuild.com/setup-password
#                     https://app.tweakandbuild.com/login
#
# With no APP_BASE_URL set, the invite is still sent — the app
# omits the redirect rather than guessing one, and Supabase uses
# the Site URL.

# ============================================================
# AI — Anthropic Claude (Haiku 4.5)
# ============================================================
# Used by:
#   src/lib/leads/outreach.ts
#   src/lib/proposals/generate.ts
ANTHROPIC_API_KEY=

# ============================================================
# Lead discovery — Google
# ============================================================
GOOGLE_PLACES_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# ============================================================
# Email — Resend (for /api/proposals/send)
# ============================================================
# Required to send proposal emails. Without it, the Email
# Proposal button returns a clear "not configured" error.
RESEND_API_KEY=
# The "from" address shown in the recipient's inbox. Must be a
# verified domain in Resend. Example: "Tweak & Build <hello@tweakandbuild.com>"
RESEND_FROM_EMAIL=
# Your own email — used as the destination for "Send Test To Myself"
# and as the reply-to address on outgoing proposal emails.
OWNER_EMAIL=

# ============================================================
# Twilio SMS — one-to-one business follow-up
# ============================================================
# Server-side only. NEVER expose any Twilio variable under
# NEXT_PUBLIC_*. Used by:
#   src/lib/sms/service.ts
#   src/app/api/sms/send/route.ts
#   src/app/api/webhooks/twilio/sms/route.ts
#
# Account SID and Auth Token from the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer the Messaging Service SID — it routes through the A2P
# campaign and handles compliance auto-replies. Fall back to
# TWILIO_FROM_NUMBER when the service SID is not configured.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+18622984988
# Master gate. Keep this `false` until the Twilio A2P campaign
# is approved. While false, no Twilio API calls are made and the
# UI shows "SMS prepared — waiting for Twilio A2P approval."
# Flip to `true` in Vercel only after the campaign is approved.
SMS_SENDING_ENABLED=false
# Validate the X-Twilio-Signature header on inbound webhook
# requests. Leave `true` in production. Configure Twilio inbound
# SMS webhook to:
#   https://app.tweakandbuild.com/api/webhooks/twilio/sms
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=true
# Keep SMS usage manual, low-volume, and relevant to active
# business follow-up. Do not build bulk or auto-blast features.

# ============================================================
# Twilio Voice — outbound click-to-call
# ============================================================
# Server-side only. NEVER expose any Twilio variable under
# NEXT_PUBLIC_*. Used by:
#   src/lib/voice/service.ts
#   src/app/api/voice/call/route.ts
#   src/app/api/webhooks/twilio/voice/bridge/route.ts
#   src/app/api/webhooks/twilio/voice/status/route.ts
#
# Voice reuses the SMS account credentials above — the same
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM_NUMBER.
# There is nothing extra to configure for the account itself.
#
# It does NOT use TWILIO_MESSAGING_SERVICE_SID: that is a
# Messaging API concept and has no meaning on the Calls API.
#
# TWILIO_FROM_NUMBER must be VOICE-CAPABLE, not just SMS-capable.
# It is what the prospect sees as the caller ID, so a number that
# cannot place calls fails every attempt.
#
# If — and only if — the voice number has to differ from the SMS
# number (a number can be SMS-capable without being voice-capable),
# set TWILIO_VOICE_FROM_NUMBER. Voice uses it in place of
# TWILIO_FROM_NUMBER for both the outbound leg and the bridge
# caller ID. Leave it unset and nothing changes; SMS never reads it.
# TWILIO_VOICE_FROM_NUMBER=
#
# How a call works:
#   1. The agent presses "Call via Twilio" on a lead.
#   2. Twilio rings agent_profiles.voice_phone — the agent's own
#      phone — from TWILIO_FROM_NUMBER.
#   3. When the agent answers, Twilio fetches the bridge TwiML and
#      dials the prospect with TWILIO_FROM_NUMBER as caller ID.
# The agent's personal number is never shown to the prospect.
#
# Set an agent's callback number one of two ways:
#   * the agent themselves, in Settings → Twilio Calling
#     (PATCH /api/my/voice-phone), or
#   * an admin, via POST /api/admin/team with
#     { action: "update", agent_id, voice_phone: "+1..." }.
# It is stored E.164 and an agent with no number set cannot place
# a call — the UI says so rather than failing at Twilio.
#
# The canonical column is public.agent_profiles.voice_phone and
# there is no other. Erasing it is an explicit action ("Remove" in
# Settings, or clear: true on the PATCH); saving an empty field
# does nothing, which is deliberate — the earlier behaviour wiped
# the number and reported success.
#
# Master gate, independent of SMS_SENDING_ENABLED on purpose:
# A2P campaign approval and voice billing are unrelated events,
# and turning one on must never turn the other on. While this is
# `false`, no Twilio call is made at all — the attempt is still
# recorded in voice_calls with status `disabled` and the UI says
# "Twilio Voice is currently disabled. The call was not placed."
# Flip to `true` in Vercel once the Twilio account can place calls.
TWILIO_VOICE_ENABLED=false
#
# Signature validation for the voice webhooks reuses
# TWILIO_WEBHOOK_VALIDATE_SIGNATURE above. Configure Twilio's
# webhooks to:
#   https://app.tweakandbuild.com/api/webhooks/twilio/voice/bridge
#   https://app.tweakandbuild.com/api/webhooks/twilio/voice/status
# Both URLs are handed to Twilio per call with a random one-off
# token, so there is nothing to configure in the Twilio console.
#
# LIVE TESTING REQUIRES AN ACTIVE TWILIO ACCOUNT. While billing is
# suspended, Twilio rejects every Calls API request; the app
# records the call as `failed` with Twilio's own message and shows
# it on the lead. That is the expected behaviour, not a bug.
#
# Calls are never recorded, and there is no auto-dialing: one lead
# at a time, initiated by a signed-in agent pressing a button.

# ============================================================
# Public origin for Twilio callbacks — SET THIS IN PRODUCTION
# ============================================================
# Twilio fetches the bridge TwiML and posts call status from the
# internet, so it needs the externally reachable origin.
#
# This is not cosmetic. The origin resolved here becomes the URL
# Twilio fetches TwiML from, and the TwiML is what decides which
# number gets dialed — so it is resolved in trust order:
#
#   1. APP_BASE_URL
#   2. NEXT_PUBLIC_APP_URL          (same value, name some setups use)
#   3. VERCEL_PROJECT_PRODUCTION_URL (injected by Vercel)
#   4. the x-forwarded-* request headers
#
# Only (4) involves anything a caller could influence, which is why
# it is last. Set APP_BASE_URL and the header path is never taken.
#
# It must be the PUBLIC PRODUCTION origin. A localhost or private
# address, or a preview deployment behind Vercel Authentication, is
# unreachable from Twilio: the agent's phone rings and then the call
# goes nowhere. The app refuses to place a call against an origin it
# can tell Twilio cannot reach, and says which variable to set.
APP_BASE_URL=https://app.tweakandbuild.com

# ============================================================
# Commission accrual cron — GET /api/cron/commissions/accrue
# ============================================================
# Bearer token Vercel Cron sends on the nightly accrual sweep. The route
# refuses every request when this is unset, so the sweep simply never runs
# until it is configured. Generate with `openssl rand -hex 32`.
# Vercel sets this automatically for projects using vercel.json crons; set it
# explicitly if you invoke the endpoint yourself.
CRON_SECRET=

# ============================================================
# Stripe — POST /api/webhooks/stripe
# ============================================================
# Endpoint signing secret from the Stripe dashboard (whsec_...). The webhook
# rejects every request when unset, so payments simply never arrive until it
# is configured.
# The charge must carry the deal it belongs to in metadata as `deal_id` —
# Stripe has no idea what a deal is, and a charge without it is logged and
# ignored rather than attached to a guessed deal.
STRIPE_WEBHOOK_SECRET=

# Days a payment sits as received before the nightly sweep marks it cleared.
# This is the chargeback buffer: commission accrues off cleared_at, never off
# received_at. Default 7.
PAYMENT_SETTLEMENT_DAYS=7
